    "@types/node": "^22.10.5",
    "@types/pdfkit": "^0.13.8",
    "@types/uuid": "^10.0.0",
    "dotenv": "^16.4.7",
    "nodemon": "^3.1.9",
    "sequelize-cli": "^6.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@types/express": "^5.0.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",

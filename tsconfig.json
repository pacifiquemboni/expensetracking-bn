{
  
  "compilerOptions": {
    "module": "commonjs",
    "target": "es6",
    "esModuleInterop": true,
    "allowJs": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "typeRoots": ["./src/types", "./node_modules/@types"],
  "include": ["src/**/*", "src/database/models", "generateReport.ts"],   // Include all files in src
  "exclude": ["node_modules"], // Exclude node_modules
 
}
